# Copie para .env (ou cadastre no painel Node.js da Hostinger). Use um banco SEPARADO para testes.
NODE_ENV=production
PORT=3000
BASE_PATH=/colaborador
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u000000_portal_teste
DB_USER=u000000_portal
DB_PASSWORD=troque-esta-senha
SESSION_HOURS=8
MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
# Biblioteca permanente de imagens (fora da pasta temporária da aplicação)
SITE_UPLOAD_DIR=/home/SEU_USUARIO/rodrinox-site-media
# Origem exata do site institucional que poderá consultar a API pública
SITE_PUBLIC_ORIGIN=https://rodrinoxpro.com.br
